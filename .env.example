# Primary Layer-5 Agent & Memo Generator (Amazon Bedrock)
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=au.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_BEARER_TOKEN_BEDROCK=

# Automatic Safety Failover & Backup Engine (Google Gemini API - stdlib REST)
# Used automatically if Amazon Bedrock is unavailable/throttled, or via `--provider gemini`
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# Optional: Set to 1 to allow Google Gemini to back up Layer-2 Decider 2B if port 8099 is down
DELTASHIELD_GEMINI_DECIDER_FALLBACK=0

# Local Strands Decider 2B server endpoint
STRANDS_DECIDER_URL=http://127.0.0.1:8099
